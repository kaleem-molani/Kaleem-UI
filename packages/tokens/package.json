{
  "name": "@kaleem-ui/tokens",
  "version": "1.0.0",
  "description": "Design tokens and semantic CSS properties for Kaleem UI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
