{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Kaleem UI",
  "version": "1.0.0",
  "description": "Initial design tokens; validate contrast and visual behavior before release.",
  "color": {
    "brand": {
      "evergreen": {
        "50": "#EAF5F0",
        "100": "#CFE9DC",
        "200": "#A5D8C0",
        "300": "#83F0C0",
        "400": "#4CCF98",
        "500": "#167653",
        "600": "#126246",
        "700": "#104F3C",
        "800": "#102C27",
        "900": "#0B211D"
      }
    },
    "neutral": {
      "0": "#FFFFFF",
      "50": "#F6F7F5",
      "100": "#EEF1EE",
      "200": "#DDE3DE",
      "300": "#C3CEC6",
      "400": "#9BAAA0",
      "500": "#718176",
      "600": "#53635A",
      "700": "#39483F",
      "800": "#252F2A",
      "900": "#17231E",
      "950": "#151A18"
    },
    "semantic": {
      "success": {
        "light": "#167653",
        "dark": "#83F0C0",
        "surfaceLight": "#EAF5F0",
        "surfaceDark": "#19372B"
      },
      "warning": {
        "light": "#8A5A00",
        "dark": "#F5C66B",
        "surfaceLight": "#FFF4D8",
        "surfaceDark": "#3B2D16"
      },
      "danger": {
        "light": "#B42318",
        "dark": "#FF9B91",
        "surfaceLight": "#FEECEB",
        "surfaceDark": "#40211F"
      },
      "info": {
        "light": "#245FC7",
        "dark": "#8AB4FF",
        "surfaceLight": "#EAF1FF",
        "surfaceDark": "#1C2C48"
      }
    }
  },
  "theme": {
    "light": {
      "canvas": "#F6F7F5",
      "surface": "#FFFFFF",
      "surfaceSubtle": "#EEF1EE",
      "surfaceElevated": "#FFFFFF",
      "textPrimary": "#17231E",
      "textSecondary": "#53635A",
      "textMuted": "#718176",
      "border": "#DDE3DE",
      "borderStrong": "#C3CEC6",
      "brand": "#102C27",
      "brandHover": "#104F3C",
      "accent": "#83F0C0",
      "focusRing": "#167653",
      "overlay": "rgba(15, 26, 21, 0.48)"
    },
    "dark": {
      "canvas": "#151A18",
      "surface": "#1D2521",
      "surfaceSubtle": "#252F2A",
      "surfaceElevated": "#2A3430",
      "textPrimary": "#F2F6F3",
      "textSecondary": "#B8C5BD",
      "textMuted": "#91A198",
      "border": "#35423B",
      "borderStrong": "#4A5A50",
      "brand": "#83F0C0",
      "brandHover": "#A5F5D2",
      "accent": "#83F0C0",
      "focusRing": "#83F0C0",
      "overlay": "rgba(0, 0, 0, 0.64)"
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem"
    },
    "lineHeight": {
      "tight": 1.2,
      "heading": 1.3,
      "normal": 1.5,
      "relaxed": 1.65
    },
    "letterSpacing": {
      "tight": "-0.025em",
      "normal": "0",
      "wide": "0.04em"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },
  "radius": {
    "none": "0",
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.625rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "full": "9999px"
  },
  "borderWidth": {
    "default": "1px",
    "strong": "2px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(16, 44, 39, 0.06)",
    "md": "0 4px 12px rgba(16, 44, 39, 0.08)",
    "lg": "0 12px 32px rgba(16, 44, 39, 0.14)"
  },
  "motion": {
    "durationFast": "100ms",
    "durationNormal": "180ms",
    "durationSlow": "260ms",
    "easeStandard": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "zIndex": {
    "base": 0,
    "sticky": 20,
    "dropdown": 30,
    "overlay": 40,
    "modal": 50,
    "toast": 60
  }
}
