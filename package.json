{
  "name": "kaleem-ui-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build",
    "lint": "oxlint --ignore-path .oxlintignore",
    "typecheck": "tsc -b",
    "test": "pnpm --filter \"./packages/*\" test",
    "release:check": "node scripts/verify-release.js && node scripts/verify-consumer.js",
    "publish:packages": "pnpm --filter @kaleem-ui/tokens publish --access public --no-git-checks && pnpm --filter @kaleem-ui/react publish --access public --no-git-checks"
  },

  "devDependencies": {
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
